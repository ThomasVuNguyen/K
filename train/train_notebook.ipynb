  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# K Training Notebook (replicates train.py)\n",
        "\n",
        "This notebook mirrors `train.py` using `config.json`, with added support for multiple datasets by allowing `dataset_config.dataset_name` to be either a single string or a list of strings.\n",
        "\n",
        "- Keep `config.json` as-is for `train.py`.\n",
        "- To use multiple datasets here, set `dataset_name` to a list in `config.json` (or pass a list via the override cell below).\n",
        "- All other behavior (LoRA, Unsloth, CSV metrics, plotting, saving, push to Hub) follows `train.py`.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "tags": []
      },
      "outputs": [],
      "source": [
        "# Optional: install dependencies (uncomment as needed)\n",
        "# %pip install -U unsloth datasets trl peft transformers accelerate einops bitsandbytes python-dotenv matplotlib pandas huggingface_hub\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Imports and config loading\n",
        "import os, json, csv, glob, shutil\n",
        "from datetime import datetime\n",
        "import torch\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from datasets import load_dataset, concatenate_datasets\n",
        "from transformers import TrainerCallback\n",
        "from trl import SFTTrainer, SFTConfig\n",
        "from unsloth import FastModel\n",
        "from unsloth.chat_templates import get_chat_template, train_on_responses_only\n",
        "\n",
        "# Load .env if available\n",
        "try:\n",
        "    from dotenv import load_dotenv\n",
        "    load_dotenv()\n",
        "    print('Loaded environment from .env')\n",
        "except Exception:\n",
        "    pass\n",
        "\n",
        "# Torch/inductor safety for older GPUs (replicates train.py)\n",
        "os.environ['TORCH_USE_CUDA_DSA'] = '1'\n",
        "os.environ['CUDA_LAUNCH_BLOCKING'] = '1'\n",
        "os.environ['TORCH_INDUCTOR'] = '0'\n",
        "os.environ['TORCHINDUCTOR_MAX_AUTOTUNE'] = '0'\n",
        "os.environ['TORCH_COMPILE_DISABLE'] = '1'\n",
        "os.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'\n",
        "\n",
        "# Disable dynamo/triton paths like in train.py\n",
        "try:\n",
        "    torch._dynamo.config.suppress_errors = True\n",
        "    torch._dynamo.reset()\n",
        "    torch._dynamo.config.disable = True\n",
        "except Exception:\n",
        "    pass\n",
        "\n",
        "# Load config.json\n",
        "with open('config.json', 'r') as f:\n",
        "    config = json.load(f)\n",
        "\n",
        "model_config     = config['model_config']\n",
        "dataset_config   = config['dataset_config']\n",
        "lora_config      = config['lora_config']\n",
        "training_config  = config['training_config']\n",
        "inference_config = config['inference_config']\n",
        "saving_config    = config['saving_config']\n",
        "logging_config   = config.get('logging_config', {'csv_log_enabled': True})\n",
        "checkpoint_config= config.get('checkpoint_config', {})\n",
        "\n",
        "# Model config\n",
        "HUB_MODEL_NAME  = model_config['hub_model_name']\n",
        "MODEL_NAME      = model_config['base_model_name']\n",
        "MAX_SEQ_LENGTH  = model_config['max_seq_length']\n",
        "LOAD_IN_4BIT    = model_config.get('load_in_4bit', True)\n",
        "LOAD_IN_8BIT    = model_config.get('load_in_8bit', False)\n",
        "FULL_FINETUNING = model_config.get('full_finetuning', False)\n",
        "\n",
        "# Dataset config (supports str or list[str])\n",
        "RAW_DATASET_NAME = dataset_config['dataset_name']\n",
        "DATASET_SPLIT    = dataset_config.get('dataset_split', 'train')\n",
        "CHAT_TEMPLATE    = dataset_config.get('chat_template', 'gemma3')\n",
        "\n",
        "# LoRA config\n",
        "LORA_R       = lora_config['r']\n",
        "LORA_ALPHA   = LORA_R * lora_config['alpha_multiplier']\n",
        "LORA_DROPOUT = lora_config['dropout']\n",
        "LORA_BIAS    = lora_config['bias']\n",
        "USE_GRADIENT_CHECKPOINTING = lora_config.get('use_gradient_checkpointing', 'unsloth')\n",
        "RANDOM_STATE  = lora_config.get('random_state', 3407)\n",
        "USE_RSLORA    = lora_config.get('use_rslora', False)\n",
        "LOFTQ_CONFIG  = lora_config.get('loftq_config', None)\n",
        "TARGET_MODULES= lora_config['target_modules']\n",
        "\n",
        "# Training config\n",
        "PER_DEVICE_TRAIN_BATCH_SIZE = training_config['per_device_train_batch_size']\n",
        "GRADIENT_ACCUMULATION_STEPS = training_config['gradient_accumulation_steps']\n",
        "WARMUP_STEPS                = training_config['warmup_steps']\n",
        "MAX_STEPS                   = training_config.get('max_steps', -1)\n",
        "NUM_TRAIN_EPOCHS            = training_config['num_train_epochs']\n",
        "LEARNING_RATE               = training_config['learning_rate']\n",
        "WEIGHT_DECAY                = training_config['weight_decay']\n",
        "LR_SCHEDULER_TYPE           = training_config['lr_scheduler_type']\n",
        "SEED                        = training_config['seed']\n",
        "OUTPUT_DIR                  = training_config['output_dir']\n",
        "REPORT_TO                   = training_config.get('report_to', 'none')\n",
        "OPTIM                       = training_config.get('optim', 'adamw_8bit')\n",
        "LOGGING_STEPS               = training_config.get('logging_steps', 1)\n",
        "SAVE_STRATEGY               = training_config.get('save_strategy', 'steps')\n",
        "SAVE_STEPS                  = training_config.get('save_steps', 300)\n",
        "SAVE_TOTAL_LIMIT            = training_config.get('save_total_limit', 3)\n",
        "EVAL_STRATEGY               = training_config.get('eval_strategy', 'no')\n",
        "EVAL_STEPS                  = training_config.get('eval_steps', 1000)\n",
        "\n",
        "# Inference and saving\n",
        "GEN_MAX_NEW_TOKENS = inference_config.get('max_new_tokens', 1024)\n",
        "GEN_TEMPERATURE    = inference_config.get('temperature', 0.8)\n",
        "GEN_TOP_P          = inference_config.get('top_p', 0.95)\n",
        "GEN_TOP_K          = inference_config.get('top_k', 64)\n",
        "GEN_DO_SAMPLE      = inference_config.get('do_sample', True)\n",
        "\n",
        "SAVE_LOCAL = saving_config.get('save_local', True)\n",
        "SAVE_16BIT = saving_config.get('save_16bit', True)\n",
        "SAVE_4BIT  = saving_config.get('save_4bit', False)\n",
        "SAVE_LORA = saving_config.get('save_lora', True)\n",
        "PUSH_TO_HUB = saving_config.get('push_to_hub', True)\n",
        "\n",
        "CSV_LOG_ENABLED = logging_config.get('csv_log_enabled', True)\n",
        "CSV_LOG_FILE = f'{HUB_MODEL_NAME}/training_metrics.csv'\n",
        "CSV_PLOT_FILE = f'{HUB_MODEL_NAME}/training_metrics.png'\n",
        "\n",
        "os.makedirs(HUB_MODEL_NAME, exist_ok=True)\n",
        "shutil.copy2('config.json', f'{HUB_MODEL_NAME}/config.json')\n",
        "print(f'Config copied to {HUB_MODEL_NAME}/config.json')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# CSV logging callback (same as train.py)\n",
        "class CSVMetricsCallback(TrainerCallback):\n",
        "    def __init__(self, csv_file_path):\n",
        "        self.csv_file_path = csv_file_path\n",
        "        self.metrics_data = []\n",
        "        self.fieldnames = ['step', 'epoch', 'loss', 'grad_norm', 'learning_rate', 'timestamp']\n",
        "        with open(csv_file_path, 'w', newline='') as csvfile:\n",
        "            writer = csv.DictWriter(csvfile, fieldnames=self.fieldnames)\n",
        "            writer.writeheader()\n",
        "    def on_log(self, args, state, control, model=None, logs=None, **kwargs):\n",
        "        if logs is not None and CSV_LOG_ENABLED:\n",
        "            metrics = {\n",
        "                'step': state.global_step,\n",
        "                'epoch': logs.get('epoch', 0),\n",
        "                'loss': logs.get('loss', None),\n",
        "                'grad_norm': logs.get('grad_norm', None),\n",
        "                'learning_rate': logs.get('learning_rate', None),\n",
        "                'timestamp': datetime.now().isoformat(),\n",
        "            }\n",
        "            if any(v is not None for v in [metrics['loss'], metrics['grad_norm'], metrics['learning_rate']]):\n",
        "                self.metrics_data.append(metrics)\n",
        "                with open(self.csv_file_path, 'a', newline='') as csvfile:\n",
        "                    writer = csv.DictWriter(csvfile, fieldnames=self.fieldnames)\n",
        "                    writer.writerow(metrics)\n",
        "                print(f\"Logged metrics: Step {metrics['step']}, Loss: {metrics['loss']}, LR: {metrics['learning_rate']}\")\n",
        "    def on_train_end(self, args, state, control, **kwargs):\n",
        "        if CSV_LOG_ENABLED:\n",
        "            print(f'\\nTraining metrics saved to: {self.csv_file_path}')\n",
        "            print(f'Total logged entries: {len(self.metrics_data)}')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load model and add LoRA adapters (Unsloth FastModel)\n",
        "model, tokenizer = FastModel.from_pretrained(\n",
        "    model_name=MODEL_NAME,\n",
        "    max_seq_length=MAX_SEQ_LENGTH,\n",
        "    load_in_4bit=LOAD_IN_4BIT,\n",
        "    load_in_8bit=LOAD_IN_8BIT,\n",
        "    full_finetuning=FULL_FINETUNING,\n",
        "    # token='hf_...'  # if gated\n",
        ")\n",
        "\n",
        "model = FastModel.get_peft_model(\n",
        "    model,\n",
        "    r=LORA_R,\n",
        "    target_modules=TARGET_MODULES,\n",
        "    lora_alpha=LORA_ALPHA,\n",
        "    lora_dropout=LORA_DROPOUT,\n",
        "    bias=LORA_BIAS,\n",
        "    use_gradient_checkpointing=USE_GRADIENT_CHECKPOINTING,\n",
        "    random_state=RANDOM_STATE,\n",
        "    use_rslora=USE_RSLORA,\n",
        "    loftq_config=LOFTQ_CONFIG,\n",
        ")\n",
        "\n",
        "# Apply chat template\n",
        "tokenizer = get_chat_template(tokenizer, chat_template=CHAT_TEMPLATE)\n",
        "print('Model and tokenizer loaded; LoRA configured.')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Dataset loading with multi-dataset support\n",
        "def to_list(x):\n",
        "    if isinstance(x, str):\n",
        "        return [x]\n",
        "    if isinstance(x, (list, tuple)):\n",
        "        return list(x)\n",
        "    raise ValueError('dataset_name must be a string or list of strings')\n",
        "\n",
        "dataset_names = to_list(RAW_DATASET_NAME)\n",
        "print('Datasets:', dataset_names)\n",
        "\n",
        "loaded = []\n",
        "for name in dataset_names:\n",
        "    print(f'Loading dataset: {name} (split={DATASET_SPLIT})')\n",
        "    ds = load_dataset(name, split=DATASET_SPLIT)\n",
        "    loaded.append(ds)\n",
        "\n",
        "if len(loaded) == 1:\n",
        "    dataset = loaded[0]\n",
        "else:\n",
        "    dataset = concatenate_datasets(loaded)\n",
        "\n",
        "# Global train/validation split (95/5 like train.py)\n",
        "dataset = dataset.train_test_split(test_size=0.05, seed=SEED)\n",
        "train_dataset = dataset['train']\n",
        "eval_dataset  = dataset['test']\n",
        "print(f'Training samples: {len(train_dataset)}, Validation samples: {len(eval_dataset)}')\n",
        "\n",
        "# Convert to conversations (expects columns: name, code) like train.py\n",
        "def convert_to_chatml(example):\n",
        "    return {\n",
        "        'conversations': [\n",
        "            {'role': 'user', 'content': 'hey cadmonkey, create me a ' + example['name']},\n",
        "            {'role': 'assistant', 'content': example['code']},\n",
        "        ]\n",
        "    }\n",
        "\n",
        "train_dataset = train_dataset.map(convert_to_chatml)\n",
        "eval_dataset  = eval_dataset.map(convert_to_chatml)\n",
        "\n",
        "def formatting_prompts_func(examples):\n",
        "    convos = examples['conversations']\n",
        "    texts = [tokenizer.apply_chat_template(c, tokenize=False, add_generation_prompt=False).removeprefix('<bos>') for c in convos]\n",
        "    return {'text': texts}\n",
        "\n",
        "train_dataset = train_dataset.map(formatting_prompts_func, batched=True)\n",
        "eval_dataset  = eval_dataset.map(formatting_prompts_func, batched=True)\n",
        "\n",
        "print('Preview example text:')\n",
        "print(train_dataset[0]['text'][:200], '...')\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Trainer setup and training (resume if checkpoints exist)\n",
        "csv_callback = CSVMetricsCallback(CSV_LOG_FILE) if CSV_LOG_ENABLED else None\n",
        "training_args = {\n",
        "    'dataset_text_field': 'text',\n",
        "    'per_device_train_batch_size': PER_DEVICE_TRAIN_BATCH_SIZE,\n",
        "    'gradient_accumulation_steps': GRADIENT_ACCUMULATION_STEPS,\n",
        "    'warmup_steps': WARMUP_STEPS,\n",
        "    'learning_rate': LEARNING_RATE,\n",
        "    'logging_steps': LOGGING_STEPS,\n",
        "    'optim': OPTIM,\n",
        "    'weight_decay': WEIGHT_DECAY,\n",
        "    'lr_scheduler_type': LR_SCHEDULER_TYPE,\n",
        "    'seed': SEED,\n",
        "    'output_dir': OUTPUT_DIR,\n",
        "    'report_to': REPORT_TO,\n",
        "    'save_strategy': SAVE_STRATEGY,\n",
        "    'save_steps': SAVE_STEPS,\n",
        "    'save_total_limit': SAVE_TOTAL_LIMIT,\n",
        "    'eval_strategy': EVAL_STRATEGY,\n",
        "    'eval_steps': EVAL_STEPS,\n",
        "}\n",
        "if MAX_STEPS and MAX_STEPS > 0:\n",
        "    training_args['max_steps'] = MAX_STEPS\n",
        "else:\n",
        "    training_args['num_train_epochs'] = NUM_TRAIN_EPOCHS\n",
        "\n",
        "trainer = SFTTrainer(\n",
        "    model=model,\n",
        "    tokenizer=tokenizer,\n",
        "    train_dataset=train_dataset,\n",
        "    eval_dataset=eval_dataset,\n",
        "    args=SFTConfig(**training_args),\n",
        ")\n",
        "if csv_callback:\n",
        "    trainer.add_callback(csv_callback)\n",
        "\n",
        "# Mask losses to responses only\n",
        "trainer = train_on_responses_only(\n",
        "    trainer,\n",
        "    instruction_part='<start_of_turn>user\n',\n",
        "    response_part='<start_of_turn>model\n',\n",
        ")\n",
        "\n",
        "# GPU stats\n",
        "gpu_props = torch.cuda.get_device_properties(0) if torch.cuda.is_available() else None\n",
        "if gpu_props:\n",
        "    start_gpu_memory = round(torch.cuda.max_memory_reserved()/1024/1024/1024, 3)\n",
        "    max_memory = round(gpu_props.total_memory/1024/1024/1024, 3)\n",
        "    print(f'GPU = {gpu_props.name}. Max memory = {max_memory} GB.')\n",
        "    print(f'{start_gpu_memory} GB of memory reserved.')\n",
        "\n",
        "# Resume if checkpoint exists\n",
        "checkpoints = glob.glob(f'{OUTPUT_DIR}/checkpoint-*')\n",
        "resume_from_checkpoint = None\n",
        "if checkpoints:\n",
        "    latest = max(checkpoints, key=lambda x: int(x.split('-')[-1]))\n",
        "    resume_from_checkpoint = latest\n",
        "    print('Resuming from', resume_from_checkpoint)\n",
        "else:\n",
        "    print('No checkpoints found; training from scratch.')\n",
        "\n",
        "trainer_stats = trainer.train(resume_from_checkpoint=resume_from_checkpoint)\n",
        "print(f"Training time (s): {trainer_stats.metrics.get('train_runtime')} ")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Metrics summary + plot (if CSV exists)\n",
        "if os.path.exists(CSV_LOG_FILE):\n",
        "    df = pd.read_csv(CSV_LOG_FILE)\n",
        "    if len(df) > 0:\n",
        "        print('Total logged steps:', len(df))\n",
        "        if 'loss' in df.columns and df['loss'].notna().any():\n",
        "            losses = df['loss'].dropna()\n",
        "            print('Final Loss:', round(losses.iloc[-1], 4))\n",
        "        # Plot\n",
        "        fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
        "        fig.suptitle('Training Metrics', fontsize=16, fontweight='bold')\n",
        "        if 'loss' in df.columns and df['loss'].notna().any():\n",
        "            axes[0,0].plot(df['step'], df['loss'], color='#e74c3c')\n",
        "            axes[0,0].set_title('Loss')\n",
        "        if 'learning_rate' in df.columns and df['learning_rate'].notna().any():\n",
        "            axes[0,1].plot(df['step'], df['learning_rate'], color='#3498db')\n",
        "            axes[0,1].set_title('Learning Rate')\n",
        "        if 'grad_norm' in df.columns and df['grad_norm'].notna().any():\n",
        "            axes[1,0].plot(df['step'], df['grad_norm'], color='#2ecc71')\n",
        "            axes[1,0].set_title('Gradient Norm')\n",
        "        if 'epoch' in df.columns and 'loss' in df.columns and df['loss'].notna().any():\n",
        "            axes[1,1].plot(df['epoch'], df['loss'], color='#9b59b6')\n",
        "            axes[1,1].set_title('Loss per Epoch')\n",
        "        plt.tight_layout()\n",
        "        plt.savefig(CSV_PLOT_FILE, dpi=300, bbox_inches='tight')\n",
        "        print('Saved plot to', CSV_PLOT_FILE)\n",
        "else:\n",
        "    print('No CSV metrics file found at', CSV_LOG_FILE)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Quick generation test\n",
        "system_prompt = 'You are a helpful CAD assistant.'\n",
        "user_prompt   = 'Create me a simple parametric cube in OpenSCAD.'\n",
        "messages = [\n",
        "    {'role': 'system', 'content': system_prompt},\n",
        "    {'role': 'user',   'content': user_prompt},\n",
        "]\n",
        "text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)\n",
        "inputs = tokenizer(text, return_tensors='pt').to(model.device)\n",
        "with torch.inference_mode():\n",
        "    outputs = model.generate(**inputs,\n",
        "        max_new_tokens=GEN_MAX_NEW_TOKENS,\n",
        "        temperature=GEN_TEMPERATURE,\n",
        "        top_p=GEN_TOP_P,\n",
        "        top_k=GEN_TOP_K,\n",
        "        do_sample=GEN_DO_SAMPLE,\n",
        "        use_cache=False,\n",
        "    )\n",
        "print('Generated response:\n', tokenizer.decode(outputs[0], skip_special_tokens=True))\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Saving: LoRA adapters and 16-bit merged model, optional push to Hub\n",
        "hf_token = os.getenv('HF_TOKEN')\n",
        "\n",
        "if SAVE_LORA:\n",
        "    print('Saving LoRA adapters...')\n",
        "    if SAVE_LOCAL:\n",
        "        model.save_pretrained(HUB_MODEL_NAME)\n",
        "        tokenizer.save_pretrained(HUB_MODEL_NAME)\n",
        "        print('Saved locally to', HUB_MODEL_NAME)\n",
        "    if PUSH_TO_HUB and hf_token:\n",
        "        model.push_to_hub(HUB_MODEL_NAME, token=hf_token)\n",
        "        tokenizer.push_to_hub(HUB_MODEL_NAME, token=hf_token)\n",
        "        print('Pushed LoRA to HF Hub at', f'https://huggingface.co/{HUB_MODEL_NAME}')\n",
        "\n",
        "if SAVE_16BIT:\n",
        "    print('Saving 16-bit merged model...')\n",
        "    local_16 = f'{HUB_MODEL_NAME}_16bit'\n",
        "    model.save_pretrained_merged(local_16, tokenizer, save_method='merged_16bit')\n",
        "    print('Saved 16-bit to', local_16)\n",
        "    if PUSH_TO_HUB and hf_token:\n",
        "        print('Uploading 16-bit merged model to Hub at', HUB_MODEL_NAME)\n",
        "        model.push_to_hub_merged(HUB_MODEL_NAME, tokenizer, save_method='merged_16bit', token=hf_token)\n",
        "        # Upload metrics files if present\n",
        "        try:\n",
        "            from huggingface_hub import HfApi\n",
        "            api = HfApi()\n",
        "            if os.path.exists(CSV_LOG_FILE):\n",
        "                api.upload_file(path_or_fileobj=CSV_LOG_FILE, path_in_repo='training_metrics.csv', repo_id=HUB_MODEL_NAME, token=hf_token)\n",
        "            if os.path.exists(CSV_PLOT_FILE):\n",
        "                api.upload_file(path_or_fileobj=CSV_PLOT_FILE, path_in_repo='training_metrics.png', repo_id=HUB_MODEL_NAME, token=hf_token)\n",
        "            print('Uploaded metrics to Hub repo.')\n",
        "        except Exception as e:\n",
        "            print('Warning: failed to upload metrics:', e)\n"
      ]
    }
  ],
